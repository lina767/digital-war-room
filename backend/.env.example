# Digital War Room – Backend ENV-Vorlage
# Kopiere nach backend/.env und trage echte Werte ein. backend/.env wird nicht committet.
# Ausführliche Bezugsquellen: docs/API-KEYS.md

# === Pflicht (mind. eines für LLM) ===
ANTHROPIC_API_KEY=
# oder: LLM_PROVIDER=openai  und  OPENAI_API_KEY=

NEWS_API_KEY=   # NewsAPI.org – Free: 100 req/day, 24h article delay, no extra requests (see docs/API-KEYS.md)
# NEWSDATA_API_KEY=       # optional: NewsData.io – 200 credits/day, 10 articles/request; filters: Location, Language, Category (see docs/API-KEYS.md)
# GNEWS_API_KEY=          # optional: GNews (gnews.io) – 100 requests/day; q, lang, country, max (see docs/API-KEYS.md)
# NEWS_MAX_PER_SOURCE=5   # max articles per outlet in top list (avoids one source dominating, e.g. Al Jazeera)
# NEWS_TOP_K=20           # total articles in news result
# === Data quality (cross-agent gate; defaults are safe) ===
# DQ_QUALITY_GATE_ENABLED=true
# DQ_SCORE_SPREAD_WARN_THRESHOLD=55   # warn when agent score min/max spread exceeds this (0–100 scale)
# Required for Proximity Analyzer and GEOINT thermal anomalies (NASA FIRMS)
NASA_FIRMS_KEY=
# Optional for SATINTEL (Sentinel Hub / Copernicus satellite imagery)
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
ALPHAVANTAGE_API_KEY=

# === Optional – ENERGY / Food & Commodities ===
# AGSI+ removed (was unreliable)
# AGSI_API_KEY=
FRED_API_KEY=
# FRED (Federal Reserve): Öl + Food Fallback (Brent/WTI täglich; Wheat/Corn/Soy monatlich). Kostenlos: https://fred.stlouisfed.org/docs/api/api_key.html

# === Optional – CHOKEPOINT / Maritime (ohne Keys: Baseline + News, data_quality estimated/baseline_only) ===
EIA_API_KEY=
# EIA: Chokepoint-Baseline; auch Energy-Agent (Brent/WTI Spot, täglich) wenn gesetzt
AISHUB_USERNAME=
# AISStream (aisstream.io) – Chokepoint Live-AIS. Es wird einer davon gelesen (gleichbedeutend):
# AISSTREAM_API_KEY=   oder  AIRSTREAM_API_KEY=   oder  AIRSTREAM_API=
AIRSTREAM_API_KEY=
# AISSTREAM_COLLECT_SECONDS=15   # or AIRSTREAM_COLLECT_SECONDS; default 15
# MARINETRAFFIC_API_KEY=   # ~15 $/Mo
# CHOKEPOINT_STATUS_URL=   # optional JSON URL: {"Strait of Hormuz": "DISRUPTED", ...}
# CHOKEPOINT_BRENT_PCT_THRESHOLD=5   # brent % move threshold for signal (default 5)

# === Optional – Hugging Face (Embeddings, Cross-Encoder, NER-Bulk) ===
HUGGINGFACE_API_KEY=
# HF_INFERENCE_API=https://api-inference.huggingface.co   # Host for /pipeline/... and /models/... (default)
# HF_API_BASE=                                           # Legacy: if set, NER/QA POST to {HF_API_BASE}/{model} instead
# HF_API_TIMEOUT=45                    # Seconds; generous for cold-start models
# HF_CACHE_MAX_SIZE=10000              # In-memory cache entries

# === Optional – Haiku (Translation, Sentiment, NER via ANTHROPIC_API_KEY) ===
# HAIKU_MODEL=claude-haiku-4-5-20251001
# HAIKU_MAX_CALLS_PER_RUN=150
# HAIKU_MAX_TRANSLATION_PER_RUN=20
# HAIKU_MAX_SENTIMENT_PER_RUN=40
# HAIKU_MAX_NER_PER_RUN=40
# HAIKU_MAX_CLASSIFY_PER_RUN=30
# HAIKU_MAX_SUMMARIZE_PER_RUN=20
# HAIKU_MAX_DOCQA_PER_RUN=10
# HAIKU_MAX_ANALYST_SUMMARY_PER_RUN=15  # Agent analyst summaries (GreyNoise, TECHINT, CYBER, etc.)
# HAIKU_MONTHLY_BUDGET=20.0            # USD, warning at 80%

# === MEDIAINT — Claude Vision (Sonnet multimodal; uses ANTHROPIC_API_KEY, separate from HAIKU_* budget) ===
# MEDIAINT_VISION_ENABLED=1
# MEDIAINT_VISION_MODEL=claude-sonnet-4-6   # default: SUPERVISOR_MODEL / get_model_name("supervisor")
# MEDIAINT_VISION_MAX_CALLS=4             # per MEDIAINT agent run (first N raster assets)
# MEDIAINT_VISION_MAX_TOKENS=1400
# MEDIAINT_VISION_MAX_SIDE=2048           # longest image edge before JPEG resize for API

# === Optional – PostgreSQL (pgvector, newsletter, GreyNoise snapshots, agent score history) ===
# When set, the app uses this database for those features instead of local SQLite files.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# CLASSIFY_CONFIDENCE_THRESHOLD=0.3    # items below this → filtered out
# SUMMARIZE_CHAR_THRESHOLD=600         # texts longer than this → summarized

# === Optional – Document QA / PDF Ingest (Phase 4) ===
# HF_DOC_QA_MODEL=deepset/roberta-base-squad2
# PDF_CHUNK_SIZE=800                   # chars per chunk
# PDF_CHUNK_OVERLAP=100                # overlap between chunks
# PDF_MAX_PAGES=200
# PDF_DOWNLOAD_TIMEOUT=60

# === Optional – PENTAGON_SIGNALS (informal DC pizza / nightlife busyness via SerpAPI Google Maps) ===
# SERPAPI_KEY=                    # https://serpapi.com — enables popular-times / live busyness for configured venues
# PENTAGON_SIGNALS_ENABLED=true   # set false to skip
# AGENT_TTL_PENTAGON_SIGNALS=21600  # 6h TTL/caching to reduce SerpAPI usage
# PENTAGON_SIGNALS_SERPAPI_HOURLY_CAP=50    # hard stop above this many searches/hour (UTC)
# PENTAGON_SIGNALS_SERPAPI_MONTHLY_CAP=250  # hard stop above this many searches/month (UTC month)
# PENTAGON_SIGNALS_MANUAL_SCORES={"pizza":60,"nightlife":45}   # optional JSON for tests without SerpAPI
# PENTAGON_SIGNALS_VENUES_JSON=[{"role":"pizza","label":"Pizza proxy","query":"..."},{"role":"nightlife","label":"Bar proxy","query":"..."}]

# === Optional – Agent handoff (closer collaboration) ===
# USE_AGENT_HANDOFF=true   # Run agents in two waves: wave 1 (finint, sigint, news, diplo, techint, cyber) then build shared context and run wave 2 (geoint, socmint, energy, protest, proximity, chokepoint, narrative) with that context (e.g. GEOINT focuses on SIGINT regions)
# SOURCE_STATUS_OVERRIDES=Source A=down;Source B=degraded
# Manual health override for incident handling in /api/agents/health and Agent Monitor.
# Format: semicolon-separated "source=status" entries; status in ok|degraded|down.

# === Optional – Signal Framework (state vs exile narrative, Iran) ===
# SIGNAL_FRAMEWORK_STATE_TIMEOUT=25                             # timeout in seconds for state feed requests (default 25)
# SIGNAL_FRAMEWORK_USE_FIRECRAWL=true                           # when set, use Firecrawl as fallback if state RSS fails (requires FIRECRAWL_API_KEY)

# === Optional – Cross-Encoder ranking queries per conflict ===
# RANKING_QUERY_IRAN=Iran nuclear sanctions military IRGC
# RANKING_QUERY_UKRAINE=Ukraine Russia military invasion NATO

# === Optional – weitere Agents (siehe docs/API-KEYS.md) ===
# OTX_API_KEY=
# GREYNOISE_API_KEY=
# RELIEFWEB_APPNAME=digital-war-room   # optional; used in ReliefWeb API requests (https://reliefweb.int/help/api)
# HAPI_APP_IDENTIFIER=                 # optional; HDX HAPI (https://hapi.humdata.org/docs) – generate at docs encode_identifier, then paste base64 here
# ACLED_EMAIL=
# ACLED_PASSWORD=
# FIRECRAWL_API_KEY=
# ADSBEXCHANGE_RAPIDAPI_KEY=
# POLYMARKET_BUILDER_API_KEY=
# METALS_API_KEY=
# ETHEREUM_ETHERSCAN_API_KEY=
# SHODAN_API_KEY=
# NOTAM_API_KEY=   # Autorouter.aero (api.autorouter.aero) – für live NOTAMs; ohne Key: Hinweis-Eintrag

# === Optional – IAEA / OE-III Tracker (Multisensor-Fusion) ===
# OEIII_ICAO_HEX=440333                    # ICAO 24-bit Hex für OE-III (Default 440333)
# IAEA_FLIGHTPLAN_STATUS_URL=             # JSON-URL für Flugplan-Status (IFPS/NMOC-Proxy): {"status":"no_new_request"|"cancelled"|"unknown","last_updated_iso":"..."}
# IAEA_FLIGHTPLAN_STATUS=                 # Optional manueller Fallback ohne URL: no_new_request|cancelled|unknown
# IAEA_FLIGHTPLAN_LAST_UPDATED_ISO=       # Optional ISO-Timestamp für manuellen Flight-Plan-Status
# IAEA_TELEGRAM_CHANNELS=                 # Kommagetrennt: Erbil/Kurdistan/IAEA-Kanäle (t.me/s-Scraping fragil/rate-limited; für Ernstfall Telethon/Pyrogram empfohlen)
# IAEA_CACHE_TTL_MINUTES=15               # Cache-TTL für Press/Telegram-Deduplication (Minuten)
# IAEA_RUNDEEP_WALLET_ACTIVITY_URL=       # Optional später: Rundeep/Wallet-Aktivität für Cross-Check

# === Optional – Observability (structlog, Sentry, OpenTelemetry) ===
# ENV=production                           # or development; structlog uses JSON in prod
# SENTRY_DSN=                               # Error tracking (Free Tier for Open Source): https://sentry.io
# SENTRY_ENVIRONMENT=production             # Sentry environment tag (defaults to ENV)
# SENTRY_RELEASE=                           # e.g. git SHA for release tracking
# SENTRY_TRACES_SAMPLE_RATE=0.1             # 0–1; performance transaction sample rate
# SENTRY_PROFILES_SAMPLE_RATE=0             # 0–1; profiling sample rate (default 0)
# SENTRY_LOG_LEVEL=INFO                     # stdlib log level forwarded to Sentry
# SENTRY_EVENT_LEVEL=ERROR                  # log events at this level and above sent as Sentry events
# OTEL_EXPORTER_OTLP_ENDPOINT=              # OTLP gRPC endpoint for traces (e.g. Better Stack, Axiom, Grafana)
# OTEL_SERVICE_NAME=digital-war-room

# === Optional – Compliance / retention / audit ===
# AUDIT_HASH_SALT=                       # optional salt for pseudonymized audit identifiers
# RETENTION_ENABLED=true                 # background retention worker
# RETENTION_INTERVAL_SEC=86400           # run once per day by default
# RETENTION_NEWSLETTER_PENDING_DAYS=30
# RETENTION_ANALYSIS_AUDIT_DAYS=180
# RETENTION_COMPLIANCE_AUDIT_DAYS=365
# RETENTION_DOCUMENT_CACHE_HOURS=72
# RETENTION_EMBEDDINGS_DAYS=180

# === Optional – Newsletter (Daily Briefing by email, Resend + double opt-in) ===
# RESEND_API_KEY=                         # Resend API key (https://resend.com)
# NEWSLETTER_FROM=                        # Sender address; use a subdomain (e.g. briefing@notifications.yourdomain.com) – see Resend: subdomain vs root domain
# FRONTEND_URL=                           # Base URL for confirm/unsubscribe links (e.g. https://digitalwarroom.com)
# After double opt-in, subscriber is synced to Resend Contacts (for Broadcasts). “Audiences” are deprecated; use a Segment ID from the Resend dashboard.
# RESEND_NEWSLETTER_SEGMENT_ID=           # UUID of segment (optional; omit = contact created without segment)
# RESEND_NEWSLETTER_SEGMENT_IDS=          # Or comma-separated list of segment UUIDs
# RESEND_AUDIENCE_ID=                     # Legacy env name; treated like a single segment ID if segment IDs above are unset
# RESEND_CONTACTS_SYNC=true               # Set false to disable Contact sync (pending/confirm/unsubscribe states)
# Newsletter send time (in-process scheduler). Default: 10:00 in Europe/Berlin (handles CET/CEST).
# NEWSLETTER_SEND_TIMEZONE=Europe/Berlin
# NEWSLETTER_SEND_HOUR=10
# NEWSLETTER_SEND_MINUTE=0
# Legacy only: fixed UTC hour (if set, overrides the timezone settings above)
# NEWSLETTER_SEND_UTC_HOUR=6
# NEWSLETTER_CRON_SECRET=                 # Secret for POST /api/newsletter/send-daily (cron); optional if using in-process job

# === Optional – CORS (bei eigener Frontend-Domain) ===
# CORS_ORIGINS=https://www.digital-war-room.com,https://digital-war-room.com
# Default: * (erlaubt alle Origins). Für Produktion mit eigener Domain explizit setzen.

# === Optional – EU sanctions list (compliance/sanctions search) ===
# Official XML may 404; set EU_SANCTIONS_URL to a working XML URL if needed.
# If XML fails and you have a CSV (e.g. from data.europa.eu or OpenSanctions eu_fsf), set:
# EU_SANCTIONS_FALLBACK_CSV_URL=https://...
# Refs: sanctionsmap.eu | data.europa.eu (consolidated list) | opensanctions.org/datasets/eu_fsf
# EU_SANCTIONS_URL=
# EU_SANCTIONS_FALLBACK_CSV_URL=

# === Multi-tenancy (optional) ===
# DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# SUPABASE_JWT_SECRET=   # or JWT_SECRET= — HS256 secret for auth.users JWT (sub = user id)
# JWT_AUDIENCE=          # optional; set if your JWTs include aud
# MULTI_TENANCY_REQUIRE_AUTH=false   # if true, unauthenticated API calls get 401
