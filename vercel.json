{
  "rewrites": [
    {
      "source": "/((?!favicon\\.ico)(?!favicon\\.png)(?!apple-touch-icon\\.png)(?!og-image\\.png)(?!robots\\.txt)(?!sitemap\\.xml)(?!manifest\\.json)(?!llms\\.txt)(?!placeholder\\.svg)(?!assets/).+)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/favicon.ico", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/favicon.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/apple-touch-icon.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
