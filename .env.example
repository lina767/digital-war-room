VITE_API_URL=http://localhost:8000
VITE_APP_ENV=development

# Optional: Supabase Auth (multi-tenant JWT for FastAPI). Project URL + anon key from Supabase dashboard.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: Mapbox GL basemap for the dashboard TheaterMap (deck.gl).
# Free tier includes ~50,000 web map loads/month — set URL restrictions in the Mapbox account.
# If unset, the map falls back to MapLibre + Carto Dark Matter (no token).
# VITE_MAPBOX_TOKEN=pk.ey...
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
